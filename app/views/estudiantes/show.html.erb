<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Datos del Estudiante</h1>
        <div>
          <%= link_to 'Volver', estudiantes_path, class: "btn btn-secondary" %>
          <% if current_user&.rol&.descripcion == 'Administrador' %>
            <%= link_to 'Editar', edit_estudiante_path(@estudiante), class: "btn btn-warning ml-2" %>
          <% end %>
        </div>
      </div>

      <%= render 'shared/flash_messages' %>

      <div class="row">
        <!-- Información Personal -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header bg-primary text-white">
              <h5 class="mb-0">Información Personal</h5>
            </div>
            <div class="card-body">
              <table class="table table-borderless">
                <tr>
                  <td><strong>Nombre Completo:</strong></td>
                  <td><%= @estudiante.fullname %></td>
                </tr>
                <tr>
                  <td><strong>RUT:</strong></td>
                  <td><%= @estudiante.rut %></td>
                </tr>
                <tr>
                  <td><strong>Fecha de Nacimiento:</strong></td>
                  <td><%= l(@estudiante.fecha_nacimiento, format: :long) if @estudiante.fecha_nacimiento %></td>
                </tr>
                <tr>
                  <td><strong>Edad:</strong></td>
                  <td><%= @estudiante.fecha_nacimiento ? ((Date.today - @estudiante.fecha_nacimiento) / 365.25).floor : 'N/A' %> años</td>
                </tr>
                <tr>
                  <td><strong>Email:</strong></td>
                  <td><%= mail_to @estudiante.email if @estudiante.email.present? %></td>
                </tr>
                <tr>
                  <td><strong>Teléfono:</strong></td>
                  <td><%= @estudiante.telefono %></td>
                </tr>
              </table>
            </div>
          </div>
        </div>

        <!-- Información Académica -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header bg-success text-white">
              <h5 class="mb-0">Información Académica</h5>
            </div>
            <div class="card-body">
              <table class="table table-borderless">
                <tr>
                  <td><strong>Carrera:</strong></td>
                  <td><%= @estudiante.carrera&.nombrecarrera || 'Sin asignar' %></td>
                </tr>
                <tr>
                  <td><strong>NEM:</strong></td>
                  <td><%= @estudiante.nem || 'No registrado' %></td>
                </tr>
                <tr>
                  <td><strong>Ranking:</strong></td>
                  <td><%= @estudiante.ranking || 'No registrado' %></td>
                </tr>
                <tr>
                  <td><strong>Situación Económica:</strong></td>
                  <td><%= @estudiante.situacioneconomica || 'No registrada' %></td>
                </tr>
                <tr>
                  <td><strong>Colegio:</strong></td>
                  <td><%= @estudiante.colegio || 'No registrado' %></td>
                </tr>
                <tr>
                  <td><strong>Estado:</strong></td>
                  <td>
                    <% if @estudiante.estado %>
                      <span class="badge badge-success">Activo</span>
                    <% else %>
                      <span class="badge badge-danger">Inactivo</span>
                    <% end %>
                  </td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Información de Ubicación -->
      <div class="row mt-4">
        <div class="col-12">
          <div class="card">
            <div class="card-header bg-info text-white">
              <h5 class="mb-0">Información de Ubicación</h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <p><strong>Dirección:</strong> <%= @estudiante.direccion %></p>
                  <p><strong>Comuna:</strong> <%= @estudiante.comuna %></p>
                </div>
                <div class="col-md-6">
                  <% if @estudiante.user.present? %>
                    <p><strong>Tutor Asignado:</strong></p>
                    <p><i class="fas fa-user-tie"></i> <%= @estudiante.user.fullname %></p>
                  <% else %>
                    <p><strong>Tutor:</strong> Sin tutor asignado</p>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Acciones Adicionales -->
      <div class="row mt-4">
        <div class="col-12">
          <div class="card">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <%= link_to 'Volver a la lista', estudiantes_path, class: "btn btn-secondary" %>
                  <% if current_user&.rol&.descripcion == 'Administrador' %>
                    <%= link_to 'Editar Estudiante', edit_estudiante_path(@estudiante), class: "btn btn-warning ml-2" %>
                    <% if @estudiante.estado %>
                      <%= link_to 'Desactivar Estudiante', estudiante_path(@estudiante), 
                          method: :delete, 
                          class: "btn btn-danger ml-2",
                          data: { confirm: '¿Está seguro que desea desactivar este estudiante?' } %>
                    <% end %>
                  <% end %>
                </div>
                <div>
                  <small class="text-muted">
                    Creado: <%= l(@estudiante.created_at, format: :short) if @estudiante.created_at %> | 
                    Actualizado: <%= l(@estudiante.updated_at, format: :short) if @estudiante.updated_at %>
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div> 
