<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Detalles de la Facultad</h1>
  <%= link_to '← Volver', facultads_path, class: "btn btn-secondary" %>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Información General</h5>
      </div>
      <div class="card-body">
        <div class="row mb-3">
          <div class="col-sm-4">
            <strong>Nombre:</strong>
          </div>
          <div class="col-sm-8">
            <%= @facultad.nombrefacultad %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-4">
            <strong>Estado:</strong>
          </div>
          <div class="col-sm-8">
            <% if @facultad.estado %>
              <span class="badge bg-success">Activo</span>
            <% else %>
              <span class="badge bg-secondary">Inactivo</span>
            <% end %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-4">
            <strong>Fecha de Creación:</strong>
          </div>
          <div class="col-sm-8">
            <%= l(@facultad.created_at, format: :long) if @facultad.created_at %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-4">
            <strong>Última Actualización:</strong>
          </div>
          <div class="col-sm-8">
            <%= l(@facultad.updated_at, format: :long) if @facultad.updated_at %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-4">
            <strong>Carreras Asociadas:</strong>
          </div>
          <div class="col-sm-8">
            <%= @facultad.carreras.count %>
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-sm-4">
            <strong>Usuarios Asociados:</strong>
          </div>
          <div class="col-sm-8">
            <%= @facultad.users.count %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mt-4">
  <div class="btn-group" role="group">
    <%= link_to 'Editar', edit_facultad_path(@facultad), class: "btn btn-primary" %>
    <%= link_to 'Ver Todas', facultads_path, class: "btn btn-outline-secondary" %>
  </div>
</div> 

