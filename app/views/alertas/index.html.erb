<div class="card">
  <div class="card-header">
    <h3 class="mb-0">Alertas Tempranas</h3>
  </div>
  <div class="card-body">
    <% if @alertas.any? %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead class="thead-dark">
            <tr>
              <th>Estudiante</th>
              <th>Profesional</th>
              <th>Prioridad</th>
              <th>Fecha</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @alertas.each do |alerta| %>
              <tr class="<%= priority_badge_class(alerta.prioridad) %>">
                <td class="font-weight-bold">
                  <%= full_student_name(alerta.informe&.estudiante) %>
                </td>
                <td>
                  <%= full_user_name(alerta.informe&.user) %>
                </td>
                <td>
                  <span class="badge <%= priority_badge_class(alerta.prioridad) %>">
                    <%= alerta.prioridad || 'N/A' %>
                  </span>
                </td>
                <td>
                  <%= format_date(alerta.created_at) %>
                </td>
                <td>
                  <%= link_to alerta_path(alerta), 
                              class: 'btn btn-primary btn-sm',
                              title: 'Ver detalles' do %>
                    <i class="fas fa-eye"></i> Ver
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-4">
        <i class="fas fa-exclamation-triangle fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">No hay alertas registradas</h5>
        <p class="text-muted">No se encontraron alertas en el sistema.</p>
      </div>
    <% end %>
  </div>
</div>


