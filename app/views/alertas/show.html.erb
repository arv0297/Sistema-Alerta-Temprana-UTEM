<div class="card">
  <div class="card-header bg-dark text-white">
    <h3 class="mb-0">Alerta Temprana</h3>
  </div>
  <div class="card-body">
    <!-- Alert Header Information -->
    <div class="row mb-4">
      <div class="col-md-6">
        <div class="alert-info">
          <h5 class="text-primary">Información General</h5>
          <p><strong>Generada por:</strong> <%= full_user_name(@informe.user) %>, <%= @informe.user.rol&.descripcion %></p>
          <p><strong>Fecha:</strong> <%= format_date(@informe.created_at) %></p>
          <p><strong>Informe N°:</strong> <%= @informe.id %></p>
          <p><strong>Estudiante:</strong> <span class="font-weight-bold text-primary"><%= full_student_name(@informe.estudiante) %></span></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="alert-priority">
          <h5 class="text-secondary">Prioridad de Alerta</h5>
          <span class="badge <%= priority_badge_class(@alerta.prioridad) %> p-3" style="font-size: 1.2rem;">
            <%= @alerta.prioridad || 'N/A' %>
          </span>
        </div>
      </div>
    </div>

    <!-- Evaluation Sections -->
    <%= render 'evaluation_section', 
               evaluations: @evaluations[:habits], 
               section_title: 'Hábitos de Estudio', 
               section_icon: 'book' %>

    <%= render 'evaluation_section', 
               evaluations: @evaluations[:vocation], 
               section_title: 'Vocación', 
               section_icon: 'graduation-cap' %>

    <%= render 'evaluation_section', 
               evaluations: @evaluations[:health], 
               section_title: 'Salud Física y Mental', 
               section_icon: 'heart' %>

    <!-- Additional Observations for Jefe de Carrera -->
    <% if @informe.user&.rol&.descripcion == 'Jefe de Carrera' && @informe.observacion.present? %>
      <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="fas fa-comment-alt"></i>
            Observaciones del Jefe de Carrera
          </h5>
        </div>
        <div class="card-body">
          <div class="alert alert-danger">
            <%= simple_format(@informe.observacion) %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Action Buttons -->
    <div class="text-center mt-4">
      <%= link_to 'Volver a Alertas', alertas_path, class: 'btn btn-secondary btn-lg' %>
      <% if can_edit_alerta? %>
        <%= link_to 'Editar Alerta', edit_alerta_path(@alerta), class: 'btn btn-warning btn-lg ml-2' %>
      <% end %>
    </div>
  </div>
</div>